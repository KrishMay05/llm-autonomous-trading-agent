# ── Trading Agent Configuration ──────────────────────────────────
# Copy to .env and fill in. NEVER commit .env with real keys.

# ── Master switches ──
LIVE_TRADING_ENABLED=false
BROKER=paper

# ── LLM ──
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_USD_PER_DAY=5.00
LLM_VETO_ENABLED=false

# ── Symbols ──
SYMBOL_ALLOWLIST=SPY,AAPL,MSFT,NVDA

# ── Risk limits ──
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_HEAT_PCT=0.40
MAX_DAILY_LOSS_PCT=0.02
MAX_ORDERS_PER_DAY=20
MAX_QUOTE_AGE_SEC=120
KILL_SWITCH=false
PDT_GUARD_ENABLED=false

# ── Strategies ──
STRATEGIES=trend_pullback_v1

# ── Data providers ──
MARKET_DATA_PROVIDER=yfinance
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# FRED_API_KEY=
# NEWSAPI_KEY=

# ── Alpaca (Phase 4) ──
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Robinhood Agentic (Phase 5) ──
