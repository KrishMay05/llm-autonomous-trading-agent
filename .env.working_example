# Working local config for spinning up the CLI loop without live APIs.
# Copy over the broken .env:
#   cp .env.working_example .env
# Then:
#   python3 scripts/run_agent.py
#
# Why this file exists: pydantic-settings treats list fields as JSON.
# `.env.example` uses CSV (SYMBOL_ALLOWLIST=SPY,AAPL) which fails with
# SettingsError: error parsing value for field "symbol_allowlist".
# There is no dashboard yet (Phase 7). This boots the paper CLI workflow.

# ── Master switches ──
LIVE_TRADING_ENABLED=false
BROKER=paper

# ── LLM (off so startup does not call OpenAI/Anthropic) ──
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_USD_PER_DAY=5.00
LLM_VETO_ENABLED=false

# ── Symbols / strategies: JSON arrays, not CSV ──
SYMBOL_ALLOWLIST=["SPY","AAPL","MSFT","NVDA"]
STRATEGIES=["trend_pullback_v1"]

# ── Risk limits ──
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_HEAT_PCT=0.40
MAX_DAILY_LOSS_PCT=0.02
MAX_ORDERS_PER_DAY=20
MAX_QUOTE_AGE_SEC=120
KILL_SWITCH=false
PDT_GUARD_ENABLED=false

# ── Data providers (unused by scripts/run_agent.py — it injects fake quotes) ──
MARKET_DATA_PROVIDER=yfinance
